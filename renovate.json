{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platform": "gitea",
  "prBodyNotes": [
    "**Depois de aprovar o merge, rode:**\n```bash\ncd ansible && ansible-playbook playbooks/platform.yml --ask-vault-pass\n```"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^ansible/roles/.+/tasks/main\\.yml$"],
      "matchStrings": [
        "helm upgrade --install \\S+ (?<depName>[\\w.-]+/[\\w.-]+)\\s*\\n?\\s*--version (?<currentValue>v?[\\w.-]+)"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}
