server:
  env:
    WOODPECKER_GITEA: "true"
    WOODPECKER_GITEA_URL: "http://192.168.122.96:30080"
    WOODPECKER_GITEA_CLIENT: "{{ woodpecker_gitea_client }}"
    WOODPECKER_GITEA_SECRET: "{{ woodpecker_gitea_secret }}"
    WOODPECKER_HOST: "http://192.168.122.96:31918"
    WOODPECKER_ADMIN: "gitea_admin"
  createAgentSecret: true
  service:
    type: NodePort
  persistentVolume:
    enabled: true
    size: 1Gi
    storageClass: local-path
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 250m
      memory: 256Mi

agent:
  env:
    WOODPECKER_BACKEND: kubernetes
    WOODPECKER_BACKEND_K8S_NAMESPACE: woodpecker
    WOODPECKER_BACKEND_K8S_STORAGE_CLASS: local-path
  persistence:
    enabled: true
    size: 1Gi
    storageClass: local-path
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 250m
      memory: 256Mi
